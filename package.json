{
  "name": "hhc-presenter",
  "version": "2.5.6",
  "description": "A projection system designed for church services.",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "author": "rayselfs",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "predev": "npm run prepare:video-engine",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && electron-vite build && npm run check:bundle",
    "build:web": "npm run typecheck && electron-vite build --mode web && npm run check:web-build && npm run check:bundle",
    "check:web-build": "node scripts/check-web-build.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:desktop-native": "node scripts/check-desktop-native.mjs",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && npm run check:desktop-native && npm run prepare:video-engine:strict && electron-builder --dir && npm run check:packaged-runtime -- --unpacked-only",
    "package:desktop": "npm run build && npm run check:desktop-native && npm run prepare:video-engine:strict && electron-builder",
    "build:win": "npm run package:desktop -- --win",
    "build:mac": "npm run package:desktop -- --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "prepare:video-engine": "node scripts/prepare-video-engine-runtime.mjs",
    "prepare:video-engine:strict": "node scripts/prepare-video-engine-runtime.mjs --strict",
    "check:packaged-runtime": "node scripts/check-packaged-runtime.mjs",
    "poc:vlc": "electron scripts/vlc-poc.cjs",
    "preview:web": "vite preview --config vite.web.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run test:e2e:browser",
    "test:e2e:browser": "playwright test --project=chromium",
    "test:e2e:packaged": "playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fontsource-variable/noto-sans-tc": "^5.2.10",
    "@fontsource-variable/roboto": "^5.2.10",
    "@heroui/react": "^3.0.2",
    "@heroui/styles": "^3.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-virtual": "^3.13.26",
    "@huggingface/transformers": "^3.8.1",
    "axios": "^1.19.0",
    "camelcase-keys": "^10.0.2",
    "electron-updater": "^6.8.9",
    "electron-vlc-player": "^1.0.2",
    "flexsearch": "^0.8.212",
    "i18next": "^26.0.3",
    "idb": "^8.0.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "parse-duration-ms": "^0.1.0",
    "pdfjs-dist": "^6.2.108",
    "pinyin-pro": "^3.28.1",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.2",
    "electron": "^41.10.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@electron/rebuild": "4.2.0",
    "sharp": "0.35.3"
  }
}
