{"id": "0500", "language": "en", "kind": "quotation", "text": "He doth execute the judgment of the fatherless and widow, and loveth the stranger, in giving him food and raiment.", "target": [5, 10, 18], "voice": "Samantha", "rate": 195, "split": "calibration", "cross_verse": false, "duration_s": 5.5825, "sha256": "4dd59ef81e2e9226fd2c778dccd99186965a28552727ce36d7798bf5ba7c681d", "transcript": "He doth execute the judgment of the fatherless and widow, and love of the stranger, in giving him food and raiment.", "decode_s": 0.5737828750861809, "cpu_s": 0.02323200000000014, "rtf": 0.10278242276510181, "max_rss_bytes": 504561664, "edits": 2, "units": 20, "reference": null, "reference_correct": null}
